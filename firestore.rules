rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function validCustomerProfile() {
      return onlyKeys([
        'fullName', 'phone', 'country', 'address', 'latitude',
        'longitude', 'marketingOptIn', 'updatedAt'
      ])
      && (!('fullName' in request.resource.data) ||
          (request.resource.data.fullName is string &&
           request.resource.data.fullName.size() <= 120))
      && (!('phone' in request.resource.data) ||
          (request.resource.data.phone is string &&
           request.resource.data.phone.size() <= 30))
      && (!('country' in request.resource.data) ||
          request.resource.data.country in ['SA', 'YE'])
      && (!('address' in request.resource.data) ||
          (request.resource.data.address is string &&
           request.resource.data.address.size() <= 500))
      && (!('latitude' in request.resource.data) ||
          (request.resource.data.latitude is number &&
           request.resource.data.latitude >= -90 &&
           request.resource.data.latitude <= 90))
      && (!('longitude' in request.resource.data) ||
          (request.resource.data.longitude is number &&
           request.resource.data.longitude >= -180 &&
           request.resource.data.longitude <= 180))
      && (!('marketingOptIn' in request.resource.data) ||
          request.resource.data.marketingOptIn is bool);
    }

    // Public storefront catalogue. Mutations are server/admin only.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Payment instructions are public storefront data only. Never store gateway
    // credentials, webhook secrets, or private provider payloads in this collection.
    match /paymentMethods/{methodId} {
      allow read: if (resource.data.enabled == true &&
        resource.data.keys().hasOnly([
          'legacyId', 'name', 'instructions', 'methodType', 'enabled',
          'sortOrder', 'countryCode', 'methodCode', 'walletTopupEnabled',
          'gatewayProvider', 'ordersEnabled', 'accountHolder',
          'accountNumber', 'accountIban', 'publicConfig', 'integrationStatus',
          'createdAt', 'updatedAt', '_migration'
        ])) || isAdmin();
      allow write: if isAdmin();
    }

    match /storeSettings/{settingId} {
      allow read: if settingId == 'currency' || isAdmin();
      allow write: if isAdmin();
    }

    match /customers/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid) && validCustomerProfile();
      allow delete: if isAdmin();
    }

    // Orders and financial state are written only by trusted Cloud Functions.
    match /orders/{orderId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /orderStatusHistory/{historyId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /orderRefunds/{refundId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /shippingProviders/{providerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /wallets/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /walletTransactions/{transactionId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /walletTopups/{topupId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /referralCodes/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /referralSignups/{signupId} {
      allow read: if (signedIn() &&
        (resource.data.referrerId == request.auth.uid ||
         resource.data.referredUserId == request.auth.uid)) || isAdmin();
      allow write: if isAdmin();
    }

    match /referralRewards/{rewardId} {
      allow read: if (signedIn() && resource.data.referrerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /referralVisits/{visitId} {
      allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Financial provider sessions, webhook payloads, shipping jobs, and telemetry
    // remain server-only. Cron auth material is never readable from client apps.
    match /privateGatewayTransactions/{id} {
      allow read, write: if isAdmin();
    }
    match /paymentWebhookEvents/{id} {
      allow read, write: if isAdmin();
    }
    match /shippingJobs/{id} {
      allow read, write: if isAdmin();
    }
    match /securityEvents/{id} {
      allow read, write: if isAdmin();
    }
    match /emailSettings/{id} {
      allow read, write: if isAdmin();
    }
    match /emailCronAuth/{id} {
      allow read, write: if false;
    }
    match /paymentSecrets/{id} {
      allow read, write: if false;
    }
    match /shippingSecrets/{id} {
      allow read, write: if false;
    }

    match /_migrationControl/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
